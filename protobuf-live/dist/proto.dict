  "webcast.im.Message": {
    "msg_type_id": 0,
    "desc": "单条消息信封，通过 method 分派业务载荷；msg_type 是信封属性，不是消息定义的唯一编号。来源：官方 Parser 运行时定义。",
    "fields": [
      {
        "field_name": "method",
        "field_number": 1,
        "proto_type": "string",
        "is_repeated": false,
        "is_nested": false,
        "comment": "传输或消息路由方法；业务信封中的字符串用于匹配官方消息类型。结构：单值；来源：官方解码字段 1。"
      },
      {
        "field_name": "payload",
        "field_number": 2,
        "proto_type": "bytes",
        "is_repeated": false,
        "is_nested": false,
        "comment": "本层协议的二进制载荷；信封载荷根据 method 路由至业务解码器。结构：单值；来源：官方解码字段 2。"
