# 只在本地复制为 .env；该文件不应包含真实凭据
DOUYIN_COOKIE=
DOUYIN_WSS_URL=
DOUYIN_USER_AGENT=Mozilla/5.0
PORT=8787
# 可选：本机 Chrome/Edge 完整路径
BROWSER_EXECUTABLE=
# 可选：包含官方 live-schema / transport-schema JS 的目录
PARSER_DIR=
# 官方 Parser 定时检查：默认开启，每 24 小时检查；最小间隔 1 小时
PARSER_AUTO_UPDATE=true
PARSER_UPDATE_INTERVAL_HOURS=24
PARSER_UPDATE_PAGE=https://live.douyin.com
# 可选：逗号分隔的 live-schema-im / transport-schema-im 官方 CDN 地址
PARSER_UPDATE_URLS=
# 外部原始包只读输入目录；所有结果写入本项目 output
RAW_PROTO_DIR=D:\Proj\LiveDash\WssBarrageServer\raw_proto
